{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeekClaw Dev",
  "identifier": "com.geekclaw.desktop.dev",
  "build": {
    "beforeBuildCommand": "bun scripts/prune-build.mjs && bun run --filter=./ui build"
  },
  "bundle": {
    "resources": []
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["geekclaw-dev"]
      }
    },
    "updater": {
      "endpoints": [
        "http://127.0.0.1:59999/geekclaw-dev-channel-has-no-update-feed/latest.json"
      ]
    }
  }
}
