{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeekClaw",
  "identifier": "com.geekclaw.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --filter=./ui dev",
    "beforeBuildCommand": "echo GeekClaw frontend dist prebuilt"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "resources": {
      "../../ui/dist/": "webui-dist/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "template": "installer.nsi"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["geekclaw"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/makeyzhang-cpu/geekclaw/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDMTI4MUIwN0I5MzE2QjQKUldTMEZwTjdzSUVTL0VtYmlEREZ5VHBEbU5uZG9vbW01SGhPOGRzbWFiL05NRnN3QTN1TzhJRmcK"
    }
  }
}
